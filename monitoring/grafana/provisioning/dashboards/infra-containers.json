{
    "id": null,
    "title": "Infra / Containers",
    "uid": "infra-containers",
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "panels": [
        {
            "title": "CPU Usage by Container",
            "type": "timeseries",
            "gridPos": {"x":0, "y":0, "w": 12, "h":10},
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.*\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "cores"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "CPU Throttling",
            "type": "timeseries",
            "gridPos": {"x":12, "y":0, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_cpu_cfs_throttled_seconds_total{name!=\"\",name!=\"POD\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Memory Usage",
            "type": "timeseries",
            "gridPos": {"x":12, "y":5, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (container_memory_usage_bytes{name!=\"\",name!=\"POD\"})",
                    "legendFormat": "{{name}}",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Memory Working Set",
            "type": "timeseries",
            "gridPos": {"x":0, "y":10, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\",name!=\"POD\"})",
                    "legendFormat": "{{name}}",
                    "refId": "D"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Memory Pressure",
            "type": "timeseries",
            "gridPos": {"x":12, "y":10, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "100 * sum by (name) (container_memory_working_set_bytes{name!=\"\",name!=\"POD\"}) / sum by (name) (container_spec_memory_limit_bytes{name!=\"\",name!=\"POD\"})",
                    "legendFormat": "{{name}}",
                    "refId": "E"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Network Receive",
            "type": "timeseries",
            "gridPos": {"x":0, "y":15, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "F"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Network Transmit",
            "type": "timeseries",
            "gridPos": {"x":12, "y":15, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m]))",
                    "legendFormat": "{{name}}",
                    "refId": "G"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Filesystem Usage",
            "type": "timeseries",
            "gridPos": {"x":0, "y":20, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "sum by (name) (container_fs_usage_bytes{id=~\"/docker/.*\"})",
                    "legendFormat": "{{name}}",
                    "refId": "H"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        },
        {
            "title": "Container Restarts",
            "type": "timeseries",
            "gridPos": {"x":12, "y":20, "w": 12, "h":5},
            "targets": [
                {
                    "expr": "changes(container_start_time_seconds{name!=\"\",name!=\"POD\"}[1h])",
                    "legendFormat": "{{name}}",
                    "refId": "I"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                }
            },
            "legend": {
                "show": true,
                "placement": "right"
            }
        }
    ]
}
